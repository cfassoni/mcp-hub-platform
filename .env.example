# HTTP listen bind settings inside Podman container (behind cloudflared tunnel)
HOST=0.0.0.0
PORT=8787

# Authoritative public HTTPS origin used for OAuth 2.1 metadata, challenges, and callbacks
# Isolate staging and friendly-user production with separate subdomains:
#   staging: https://staging-mcp.example.com
#   prod:    https://mcp.example.com
APP_BASE_URL=https://staging-mcp.example.com

# Persistent SQLite database path (WAL mode + ON DELETE CASCADE)
SQLITE_PATH=/data/mcphub.sqlite

# 256-bit AES-GCM master key (64 hex chars, 43 unpadded base64url chars, or 44 padded base64 chars)
# Generate locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=replace-with-generated-256-bit-key

# Automatic inactivity purge threshold in days
USER_INACTIVITY_TTL_DAYS=60
